  "articles": [
    {
      "id": "art_1",
      "title": "Kenali Anemia: Penyebab, Gejala 5L, dan Dampaknya pada Remaja Putri",
      "category": "Anemia",
      "summary": "Pahami mengapa remaja putri rentan anemia saat menstruasi dan bagaimana cara mendeteksi tanda-tanda 5L (Lesu, Lelah, Letih, Lemah, Lalai).",
      "leadParagraph": "Anemia defisiensi besi merupakan kondisi penurunan jumlah sel darah merah atau kadar hemoglobin akibat kurangnya asupan zat besi dalam pola makan sehari-hari.",
      "imageUrl": "https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=600&auto=format&fit=crop&q=80",
      "imageCaption": "Ilustrasi pemeriksaan hemoglobin dan pencegahan anemia remaja putri",
      "readTime": "4 Menit Baca",
      "status": "Terbit",
      "isFeatured": true,
      "views": 320,
      "publishedAt": "2026-09-18",
      "authorId": "adm_1",
      "authorName": "Tim Medis Fe-Tablet",
      "authorRole": "Fasilitator Kesehatan Sekolah",
      "authorAvatarUrl": "https://images.unsplash.com/photo-1559839734-2b71ea197ec2?q=80&w=200&auto=format&fit=crop",
      "keyTakeaways": "[\"Remaja putri kehilangan 1.5-2mg zat besi setiap hari saat menstruasi\", \"Gejala 5L menurunkan konsentrasi belajar dan daya tahan tubuh\", \"Minum TTD 1x seminggu mampu mencegah penurunan kadar Hb secara signifikan\"]",
      "tags": "[\"Anemia\", \"Remaja Putri\", \"Gejala 5L\", \"Hemoglobin\"]",
      "sections": [
        {
          "orderIndex": 1,
          "heading": "Mengapa Remaja Putri Rentan Mengalami Anemia?",
          "subheading": "Faktor biologis dan fase pertumbuhan pesat",
          "paragraphs": "[\"Masa remaja adalah fase pertumbuhan pesat (growth spurt) yang membutuhkan pasokan zat besi tinggi untuk pembentukan massa otot dan peningkatan volume darah.\", \"Selain itu, siklus menstruasi bulanan menyebabkan kehilangan darah secara berkala. Tanpa suplementasi zat besi yang cukup, simpanan zat besi dalam tubuh akan cepat menipis.\"]",
          "calloutType": "tip",
          "calloutTitle": "Fakta Penting",
          "calloutText": "Lebih dari 30% remaja putri di Indonesia berisiko mengalami anemia jika tidak rutin mengonsumsi TTD 1x seminggu.",
          "bulletPoints": "[\"Kadar Hb normal remaja putri: minimal 12.0 g/dL\", \"Anemia Ringan: 11.0 - 11.9 g/dL\", \"Anemia Sedang: 8.0 - 10.9 g/dL\", \"Anemia Berat: < 8.0 g/dL\"]"
        }
      ]
    },
    {
      "id": "art_2",
      "title": "Cara Minum Tablet Tambah Darah yang Benar Tanpa Rasa Mual",
      "category": "TTD",
      "summary": "Tips praktis minum TTD setelah makan malam atau menjelang tidur dengan air putih atau jus jeruk kaya vitamin C.",
      "leadParagraph": "Rasa mual ringan setelah minum TTD adalah respons alami lambung saat menyerap zat besi. Dengan trik waktu dan pendamping yang tepat, konsumsi TTD akan bebas mual.",
      "imageUrl": "https://images.unsplash.com/photo-1584308666744-24d5c474f2ae?w=600&auto=format&fit=crop&q=80",
      "imageCaption": "Kombinasi TTD dan jus jeruk kaya vitamin C",
      "readTime": "3 Menit Baca",
      "status": "Terbit",
      "isFeatured": false,
      "views": 215,
      "publishedAt": "2026-09-14",
      "authorId": "adm_2",
      "authorName": "dr. Siti Rahma, Sp.PD",
      "authorRole": "Spesialis Penyakit Dalam",
      "authorAvatarUrl": "https://images.unsplash.com/photo-1594824813589-cf9b009e4d0b?q=80&w=200&auto=format&fit=crop",
      "keyTakeaways": "[\"Jangan minum TTD saat perut kosong melompong\", \"Konsumsi vitamin C dapat melipatgandakan penyerapan zat besi\", \"Beri jeda 2 jam sebelum/sesudah minum teh, kopi, atau susu\"]",
      "tags": "[\"TTD\", \"Tips Bebas Mual\", \"Vitamin C\", \"Suplementasi\"]",
      "sections": [
        {
          "orderIndex": 1,
          "heading": "3 Aturan Emas Konsumsi TTD Bebas Mual",
          "subheading": "Langkah praktis untuk kebiasaan nyaman",
          "paragraphs": "[\"1. Minum TTD setelah makan malam atau 30 menit sebelum tidur malam.\", \"2. Minum bersama air putih atau sari buah jeruk/lemon.\", \"3. Hindari teh, kopi, susu, dan tablet kalsium karena dapat mengikat zat besi.\"]",
          "calloutType": "tip",
          "calloutTitle": "Rekomendasi Waktu",
          "calloutText": "Waktu terbaik adalah malam hari setelah makan malam untuk meminimalkan persepsi rasa tidak nyaman di lambung."
        }
      ]
    },
